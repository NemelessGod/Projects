# Local development only; never expose the trust-auth database to a network.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/spin_kingdom
# Physical Android device: use a reachable HTTPS backend, not localhost.
# Debug USB: adb reverse tcp:8000 tcp:8000 then use http://127.0.0.1:8000
SPIN_API_URL=http://127.0.0.1:8000
